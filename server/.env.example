# Porta da API Express
PORT=3001

# Usuário do GitHub consultado pela API
GITHUB_USERNAME=joaopedroandrad3

# (Opcional) Personal Access Token do GitHub para aumentar o limite de 60 para 5000 req/hora
# Crie em: https://github.com/settings/tokens (não precisa de permissões privadas)
GITHUB_TOKEN=

# Tempo de cache em minutos para economizar chamadas à API do GitHub
CACHE_TTL_MINUTES=10
